<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <EtabsApiPath Condition="'$(EtabsApiPath)' == '' and Exists('$(ProgramFiles)\Computers and Structures\ETABS 22\CSiAPIv1.dll')">$(ProgramFiles)\Computers and Structures\ETABS 22\CSiAPIv1.dll</EtabsApiPath>
    <EtabsApiPath Condition="'$(EtabsApiPath)' == ''">$(ProgramFiles)\Computers and Structures\ETABS 23\CSiAPIv1.dll</EtabsApiPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\BeamDemandExport.cs" Link="BeamDemandExport.cs" />
    <Compile Include="..\BeamScheduleSummary.cs" Link="BeamScheduleSummary.cs" />
    <Compile Include="..\DemandScheduleWriter.cs" Link="DemandScheduleWriter.cs" />
    <Compile Include="..\ReinforcementSelection.cs" Link="ReinforcementSelection.cs" />
    <Compile Include="..\RevitBeamMapping.cs" Link="RevitBeamMapping.cs" />
    <Compile Include="..\RevitMappingPasses.cs" Link="RevitMappingPasses.cs" />
    <Compile Include="..\RevitMappingSheet.cs" Link="RevitMappingSheet.cs" />
    <Reference Include="CSiAPIv1">
      <HintPath>$(EtabsApiPath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
